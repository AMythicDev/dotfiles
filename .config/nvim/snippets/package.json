{
  "name": "custom-asm-snippets",
  "publisher": "custom",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.11.0"
  },
  "contributes": {
    "snippets": [
      {
        "language": [
          "asm",
          "s"
        ],
        "path": "./asm.json"
      },
      {
        "language": [
          "markdown"
        ],
        "path": "./markdown.json"
      },
      {
        "language": [
          "typst"
        ],
        "path": "./typst.json"
      }
    ]
  }
}
